# Neops 2.0 — local, with the 1.0 task path. Copy to .env, then: ./neops install.
# Reference for every key: .env.example
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.yaml:compose.expose.yaml
# examples/local.env plus core's Celery worker and beat, for a deployment that still runs
# Neops tasks (providers, cron jobs) next to the 2.0 workflows. The profile starts the
# cms-worker and cms-beat containers; a task executed from the CMS is queued on Redis and the
# worker runs it. Remove the line, then ./neops down and ./neops up, to stop them again.
COMPOSE_PROFILES=cms-tasks
# NEOPS_CMS_WORKER_CONCURRENCY=2
# Everything below is examples/local.env unchanged.
# A single-machine deployment in the spirit of neops-lab: no proxy, no TLS, local password
# login, every service on its own 127.0.0.1 port. Open http://localhost:8080 in a browser on
# this host. Nothing else can reach it, and nothing else should: without a proxy the engine's
# worker API is open on port 3030 to every process on this host, which is why the bind address
# must stay 127.0.0.1.
NEOPS_WEB_URL=http://localhost:8080
NEOPS_CMS_URL=http://localhost:8000
NEOPS_ENGINE_URL=http://localhost:3030
NEOPS_WORKFLOWS_URL=http://localhost:3031
NEOPS_BIND_ADDRESS=127.0.0.1
NEOPS_WEB_PORT=8080
NEOPS_CMS_PORT=8000
NEOPS_ENGINE_PORT=3030
NEOPS_MONITOR_PORT=3031
# Every secret below is a fixed, published value so a local box needs no lookup to log into
# or connect to. That is only allowed because NEOPS_DISABLE_SECURITY_CHECKS turns off the rules
# that would reject them, and ./neops warns for as long as it is on. None of this may be copied
# to a deployment anyone else can reach: the values here are in the repository.
NEOPS_DISABLE_SECURITY_CHECKS=true
NEOPS_CMS_DB_PASSWORD=neops
NEOPS_ENGINE_DB_PASSWORD=neops
DJANGO_SECRET_KEY=neops
NEOPS_ADMIN_USER=neops
NEOPS_ADMIN_EMAIL=neops@example.com
NEOPS_ADMIN_PASSWORD=neops
# This deployment shares its disk with everything else on the machine, so cap what the
# percentage watermarks in compose.yaml demand: high=90% otherwise reserves 10% of the
# whole filesystem, which on a large disk is far more than this stack will ever use.
NEOPS_ES_HEADROOM=5GB
