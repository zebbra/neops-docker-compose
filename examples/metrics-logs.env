# Neops 2.0 — metrics and logs. Copy to .env, run ./neops secrets,
# set your hostnames, then: ./neops install.  Reference for every key: .env.example
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.yaml:compose.traefik.yaml:compose.tls-files.yaml:compose.grafana.yaml:compose.metrics.yaml:compose.logs.yaml
# Adds Grafana, VictoriaMetrics, vmalert, the exporters and VictoriaLogs, the log store of the
# engine and the CMS. Grafana is public at NEOPS_GRAFANA_URL (remove that line to keep it on
# 127.0.0.1:3000 only) and downloads its VictoriaLogs plugin on its first start, which needs
# outbound internet.
# VictoriaLogs keeps lines for NEOPS_LOG_RETENTION (d or w, the unit is required); with
# NEOPS_LOG_RETENTION_ENABLED=True the CMS also deletes executions older than that.
NEOPS_WEB_URL=https://neops.example.com
NEOPS_CMS_URL=https://cms.neops.example.com
NEOPS_ENGINE_URL=https://engine.neops.example.com
NEOPS_WORKFLOWS_URL=https://workflows.neops.example.com
NEOPS_GRAFANA_URL=https://grafana.neops.example.com
NEOPS_HTTP_PORT=80
NEOPS_HTTPS_PORT=443
NEOPS_TLS_CERT_FILE=./certs/cert.pem
NEOPS_TLS_KEY_FILE=./certs/key.pem
NEOPS_LOG_RETENTION=30d
NEOPS_GRAFANA_ADMIN_PASSWORD=
NEOPS_CMS_DB_PASSWORD=
NEOPS_ENGINE_DB_PASSWORD=
DJANGO_SECRET_KEY=
NEOPS_ADMIN_USER=neops
NEOPS_ADMIN_EMAIL=neops@example.com
NEOPS_ADMIN_PASSWORD=
