# Neops 2.0 — traefik-shared-host-upstream-tls. Copy to .env, run ./neops secrets,
# set your hostname and proxy addresses, then: ./neops install.  Reference for every key: .env.example
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.yaml:compose.traefik.yaml:compose.traefik-shared-host.yaml
# Your proxy terminates TLS for this one hostname and forwards plain HTTP to
# NEOPS_PROXY_BIND_ADDRESS:NEOPS_HTTP_PORT. Traefik routes by path behind it and trusts the
# X-Forwarded-Proto and X-Real-IP of NEOPS_TRUSTED_PROXY_IPS, so your proxy must OVERWRITE both.
NEOPS_WEB_URL=https://neops.example.com
NEOPS_CMS_URL=https://neops.example.com
NEOPS_ENGINE_URL=https://neops.example.com/engine
NEOPS_WORKFLOWS_URL=https://neops.example.com/workflows
NEOPS_HTTP_PORT=8080
NEOPS_PROXY_BIND_ADDRESS=127.0.0.1
NEOPS_TRUSTED_PROXY_IPS=172.16.0.0/12
NEOPS_CMS_DB_PASSWORD=
NEOPS_ENGINE_DB_PASSWORD=
DJANGO_SECRET_KEY=
NEOPS_ADMIN_USER=neops
NEOPS_ADMIN_EMAIL=neops@example.com
NEOPS_ADMIN_PASSWORD=
