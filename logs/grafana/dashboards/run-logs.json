  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Lines",
      "description": "Newest first, by time then seq, at most 5000 lines: narrow the time range or the filters to see earlier ones. Each line is prefixed with its service, run, step, workflow, function block and entity.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "enableInfiniteScrolling": false,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "(\"service${workflow_execution_id:percentencode}\":* or workflow_execution_id:in($workflow_execution_id)) (\"service${job_id:percentencode}\":* or job_id:in($job_id)) (\"service${entity_type:percentencode}\":* or entity_type:in($entity_type)) (\"service${entity_id:percentencode}\":* or entity_id:in($entity_id)) service:$service level:$level step_label:$step_label workflow_package:$workflow_package workflow_name:$workflow_name workflow_version:$workflow_version function_block_package:$function_block_package function_block_name:$function_block_name function_block_version:$function_block_version | sort by (_time desc, seq desc) limit 5000 | format if (entity_id:*) \"entity=<entity_type>/<entity_id> <_msg>\" as _msg | format if (function_block_name:*) \"fb=<function_block_package>/<function_block_name>:<function_block_version> <_msg>\" as _msg | format if (function_block_name:\"\" function_block_id:*) \"fb=<function_block_id> <_msg>\" as _msg | format if (workflow_name:*) \"wf=<workflow_package>/<workflow_name>:<workflow_version> <_msg>\" as _msg | format if (workflow_name:\"\" workflow_id:*) \"wf=<workflow_id> <_msg>\" as _msg | format if (step_label:*) \"step=<step_label> <_msg>\" as _msg | format if (workflow_execution_id:*) \"run=<workflow_execution_id> <_msg>\" as _msg | format if (service:*) \"[<service>] <_msg>\" as _msg",
          "maxLines": 5000
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Lines with their context",
      "description": "The same lines, one column per context field. Click a run id or job id to filter the dashboard by it.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "workflow_execution_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Filter by this run",
                    "url": "/d/neops-run-logs/run-logs?${__url_time_range}&var-workflow_execution_id=${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "job_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Filter by this job",
                    "url": "/d/neops-run-logs/run-logs?${__url_time_range}&var-job_id=${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Line"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "message"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Time",
                "level",
                "service",
                "workflow_execution_id",
                "step_label",
                "job_id",
                "workflow_package",
                "workflow_name",
                "workflow_version",
                "workflow_id",
                "function_block_package",
                "function_block_name",
                "function_block_version",
                "function_block_id",
                "entity_type",
                "entity_id",
                "Line"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "level": 1,
              "service": 2,
              "workflow_execution_id": 3,
              "step_label": 4,
              "job_id": 5,
              "workflow_package": 6,
              "workflow_name": 7,
              "workflow_version": 8,
              "workflow_id": 9,
              "function_block_package": 10,
              "function_block_name": 11,
              "function_block_version": 12,
              "function_block_id": 13,
              "entity_type": 14,
              "entity_id": 15,
              "Line": 16
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "(\"service${workflow_execution_id:percentencode}\":* or workflow_execution_id:in($workflow_execution_id)) (\"service${job_id:percentencode}\":* or job_id:in($job_id)) (\"service${entity_type:percentencode}\":* or entity_type:in($entity_type)) (\"service${entity_id:percentencode}\":* or entity_id:in($entity_id)) service:$service level:$level step_label:$step_label workflow_package:$workflow_package workflow_name:$workflow_name workflow_version:$workflow_version function_block_package:$function_block_package function_block_name:$function_block_name function_block_version:$function_block_version | sort by (_time desc, seq desc) limit 5000",
          "maxLines": 5000
        }
      ]
    }
  ]
}
