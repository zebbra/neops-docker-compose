# e2e only: the logs scenario with Loki in place of VictoriaLogs, for the key-set comparison
# between the two stores. run_scenario.py tests/e2e/examples/loki.env runs it. Not an operator
# example: Loki is bring-your-own, and the harness supplies one through compose.loki-test.yaml.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.yaml:compose.traefik.yaml:compose.tls-files.yaml:compose.grafana.yaml
E2E_OVERLAYS=tests/e2e/compose.loki-test.yaml
NEOPS_LOG_BACKEND=loki
NEOPS_LOG_URL=http://loki:3100
NEOPS_WEB_URL=https://neops.example.com
NEOPS_CMS_URL=https://cms.neops.example.com
NEOPS_ENGINE_URL=https://engine.neops.example.com
NEOPS_WORKFLOWS_URL=https://workflows.neops.example.com
NEOPS_HTTP_PORT=80
NEOPS_HTTPS_PORT=443
NEOPS_TLS_CERT_FILE=./certs/cert.pem
NEOPS_TLS_KEY_FILE=./certs/key.pem
NEOPS_LOG_RETENTION=30d
NEOPS_GRAFANA_ADMIN_PASSWORD=
NEOPS_CMS_DB_PASSWORD=
NEOPS_ENGINE_DB_PASSWORD=
DJANGO_SECRET_KEY=
NEOPS_ADMIN_USER=neops
NEOPS_ADMIN_EMAIL=neops@example.com
NEOPS_ADMIN_PASSWORD=
